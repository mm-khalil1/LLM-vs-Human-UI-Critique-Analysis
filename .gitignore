# ---------------------------------------------------------------
# Publish source code only.
# Strategy: ignore everything, then re-include the file types we
# publish. Anything new (results, data, batch files, exports) is
# excluded by default and cannot be committed by accident.
# ---------------------------------------------------------------

# 1. Ignore every file...
*

# 2. ...but descend into directories so the rules below can match.
!*/

# 3. Re-include source and project files.
!*.py
!*.ipynb
!README.md
!LICENSE
!requirements.txt
!.gitignore
!.env.example

# 4. Never descend into these at all.
#    (Listed last so they override rule 2. Also keeps `git status`
#     fast by skipping the 80k+ files under the datasets.)
.venv/
.cache/
.claude/
.codex/
.agents/
__pycache__/
# Leftover pre-restructure folder (old vendored irrCAC - install from PyPI instead)
code/

# Generated outputs and data - not published
results/*
data/raw/
data/processed/*/*

# 5. Exceptions: irreplaceable human input - manual LLM-judge relation labels, plus the
#    qualitative review verdicts and the frozen samples they point into (by sample_index).
#    Each parent folder is re-included and its other contents ignored again.
!results/critiques/
results/critiques/*
!results/critiques/analysis/
results/critiques/analysis/*
!results/critiques/analysis/tables/
results/critiques/analysis/tables/*
!results/critiques/analysis/tables/qualitative_examples/
results/critiques/analysis/tables/qualitative_examples/*
!results/critiques/analysis/tables/qualitative_examples/pair_review_labels.csv
!results/critiques/analysis/tables/qualitative_examples/*_review_sample.csv
!results/critiques/analysis/tables/qualitative_examples/sampling.json
!results/critiques/matching/
results/critiques/matching/*
!results/critiques/matching/*/
results/critiques/matching/*/*
!results/critiques/matching/*/zero_shot-all_tasks/
results/critiques/matching/*/zero_shot-all_tasks/*
!results/critiques/matching/*/zero_shot-all_tasks/llmjudge_matching/
results/critiques/matching/*/zero_shot-all_tasks/llmjudge_matching/*
!results/critiques/matching/*/zero_shot-all_tasks/llmjudge_matching/llmjudge_manual_relation_overrides-*.csv

# 6. Exception: hand-made parsing corrections and semantic-dedup decisions, plus the
#    qualitative codebook used by the matching analysis.
!data/processed/2_parsed/manual_comment_parsing_corrections.json
!data/processed/3_human_reference/deduplicating_semantic_human_critiques/
data/processed/3_human_reference/deduplicating_semantic_human_critiques/*
!data/processed/3_human_reference/deduplicating_semantic_human_critiques/semantic_manual_decisions.csv
!notebooks/3_analysis/qualitative_codebook.yaml

# 7. Exception: batch schedules - which screens/tasks went to which model, and the
#    few-shot examples. Small experiment inputs, kept for reproducibility.
!data/schedules/*.parquet
