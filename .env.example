# Copy this file to .env in the project root and fill in the keys you need:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real keys.
# Loaded automatically by utils/models_setup.py via python-dotenv.
#
# You only need keys for the providers you actually intend to run.
# Each inference notebook uses a single provider.

# --- Providers used to produce the results in this study -----------
# gpt-5.2            (code/experiment_notebooks/OpenAI_Pipeline/)
# Also used for the LLM-judge comment matching stage.
OPENAI_API_KEY=

# claude-opus-4-7    (code/experiment_notebooks/Claude_Pipeline/)
ANTHROPIC_API_KEY=

# gemini-3.7-flash   (code/experiment_notebooks/Gemini_Pipeline/)
GOOGLE_API_KEY=

# qwen3-vl-32b via OpenRouter
OPENROUTER_API_KEY=

# Optional courtesy headers sent with OpenRouter requests.
# Omit them and the requests still work.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# --- Configured in utils/models_setup.py but not used in the study --
# Provided for reproducing the pipeline with additional models.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
